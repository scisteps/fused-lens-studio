rules_version = '2';

// ============================================================================
// Animation Guild Uganda — Firestore Security Rules
//
// ⚠️ REFERENCE COPY ONLY. The live rules are edited in the Firebase Console
//    (Build -> Firestore Database -> Rules) for project animationguilduganda-ef533.
//    This repo has no firebase.json / .firebaserc / firebase CLI wiring, so
//    nothing here deploys automatically.
//
// ⚠️ MERGE, DO NOT REPLACE. siteContent, members and newsEvents are written by
//    the /admin/* dashboards, which currently have NO authentication. Do not add
//    a blanket "deny everything else" clause or the CMS breaks in production.
//    See src/lib/ARCHITECTURE.md section 12.
//
// This block adds ONLY the `users` collection used by the member signup flow
// (src/lib/auth.js -> signUpWithEmail, src/pages/SignUp.jsx).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- MEMBER ACCOUNTS ----------------
    match /users/{userId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Admins are marked with an `isAdmin == true` boolean on their own
      // users/{uid} profile (set manually in the Firebase console, never by
      // the signup form). A document lookup is used rather than a custom
      // claim so no server/CLI step is needed.
      function isAdmin() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      // The isAdmin flag must never be self-assigned: it defaults to missing/
      // false on create and cannot change on a self-service update. Admins
      // flip it from the Firebase console (or any isAdmin() write below).
      function adminFlagUnchanged() {
        return request.resource.data.get('isAdmin', false)
          == resource.data.get('isAdmin', false);
      }

      // Mirrors validate() in src/pages/SignUp.jsx. The client check is UX;
      // this is the actual guarantee.
      function isValidProfile() {
        let d = request.resource.data;
        return d.uid == request.auth.uid
          && d.role == 'member'                      // no self-promotion
          && !('isAdmin' in d && d.isAdmin == true)  // admin flag is never self-assigned
          && d.status in ['pending', 'active']
          && d.name is string        && d.name.size() >= 2 && d.name.size() <= 80
          && d.email is string       && d.email.matches('.+@.+\\..+')
          && d.phone is string       && d.phone.matches('^\\+[1-9][0-9]{7,14}$')
          && d.dateOfBirth is string && d.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.isStudent is bool
          // CATEGORY CHECK (server side): one of the known ids, and the
          // `isStudent` flag must agree with it. Without the agreement clause
          // a client could claim category 'professional' while setting
          // isStudent true and skip the institution requirement entirely.
          // The ids must match MEMBER_CATEGORIES in src/data/signup.js.
          && d.category in ['student', 'professional', 'studio', 'associate', 'patron']
          && d.isStudent == (d.category == 'student')
          // Optional dialling code kept for reference only — `phone` above is
          // the authoritative E.164 value.
          && (!('countryCode' in d)
              || (d.countryCode is string && d.countryCode.matches('^\\+[1-9][0-9]{1,3}$')))
          // STUDENT CHECKER, now keyed off the category:
          //   * a student MUST name a school, and carries no profession
          //   * a non-student MUST name a profession, and carries no school
          && (
               (d.isStudent == true
                && d.school is string && d.school.size() >= 2
                && (!('profession' in d) || d.profession == null || d.profession == ''))
               ||
               (d.isStudent == false
                && d.profession is string && d.profession.size() >= 2
                && (!('school' in d) || d.school == null || d.school == ''))
             );
      }

      allow read:   if isOwner() || isAdmin();
      allow create: if isOwner() && isValidProfile();
      allow update: if (isOwner() && isValidProfile() && adminFlagUnchanged())
        || (isAdmin() && adminFlagUnchanged());
      allow delete: if isAdmin();
    }

    // ---------------- PUBLISHED SITE CONTENT (admin-only writes) ----------------
    // `themeId` lives on siteContent/main alongside the CMS copy, so it gets
    // the same protection. Reads stay public (the site must render), but only
    // an isAdmin user can create/update/delete. Until this block is pasted
    // into the console, the dashboards keep working exactly as today.
    match /siteContent/{docId} {
      function isAdmin() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------- EXISTING COLLECTIONS (leave as-is) ----------------
    // siteContent/{doc}  (+ /versions)   <- ContentDashboard
    // members/{doc}                      <- MembersDashboard + public /members
    // newsEvents/{doc}                   <- NewsEventsDashboard + public /news-events
    //
    // Keep whatever currently protects these. TODO (separate task): put the CMS
    // behind authentication, then tighten these rules.

    // ---------------- NOTIFICATIONS ----------------
    // The public bell menu. Reads are open, because everyone — signed in or
    // not — is meant to see the notifications themselves. Only the dashboard
    // (/admin/notifications) writes.
    //
    // A notification is { title, subtitle, imageId?, imageUrl?, type, articleId? }.
    // `type` is constrained to the kinds in data/notifications.js so a bad
    // write cannot produce a link the public site cannot render:
    //   article -> needs an articleId, and that id is URL-encoded on the way
    //              into /news-events?article=... (handled in the client helper)
    //   news    -> the news & events index
    //   login   -> the sign-in page
    //
    // NOTE: this block is only protective once it is pasted into the Firebase
    // Console rules. Until then the collection follows whatever the existing
    // console rules say.
    match /notifications/{docId} {
      function isAdmin() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() <= 300
        && request.resource.data.type in ['article', 'news', 'login']
        // An article notification must name a story, otherwise notificationHref()
        // returns '' and the entry would be inert.
        && (request.resource.data.type != 'article'
            || (request.resource.data.articleId is string
                && request.resource.data.articleId.size() >= 1));
      // Deletes are only ever done by re-publishing the whole list, which
      // arrives as a batch of deletes with no request.resource.data.
      allow delete: if isAdmin();
    }
  }
}
